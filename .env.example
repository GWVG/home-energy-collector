# --- Local devices ---
NIBE_HOST=192.168.x.x
HW_IP=192.168.x.x
DUCO_IP=192.168.x.x
# Huawei SUN2000 inverter, reached through the SDongleA (Modbus TCP, port 502).
# Reading needs no installer password.
HUAWEI_DONGLE_IP=192.168.x.x
# HUAWEI_UNIT_ID=1    # Modbus unit ID of the inverter itself (the dongle is 0)
# HUAWEI_TIMEOUT=10   # seconds, per Modbus call

# health_endpoint.py on the Proxmox host itself (not in a container)
HEALTH_ENDPOINT_URL=http://proxmox.local:9100/health

# NIBE credentials are not set here: HTTP Basic Auth is read from ~/.netrc
# (machine <NIBE_HOST>, login/password).

# --- Weather ---
# Location for Open-Meteo (no API key needed)
OPEN_METEO_LAT=51.0
OPEN_METEO_LON=4.0

# --- InfluxDB ---
# INFLUX_URL=http://localhost:8086
INFLUX_ORG=your_org
INFLUX_BUCKET=your_bucket
# Write-only token: the collector never needs to read (least privilege).
INFLUX_COLLECTOR_TOKEN=your_write_only_token

# --- Intervals (seconds) ---
# COLLECTOR_INTERVAL=60
# OUTDOOR_WEATHER_INTERVAL=300
# METEOBELGIE_INTERVAL=3600
